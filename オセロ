<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>オセロ</title>

<style>
body{
    background:#222;
    color:white;
    text-align:center;
    font-family:sans-serif;
}

h1{
    margin-top:20px;
}

#board{
    width:336px;
    height:336px;
    margin:20px auto;
    display:grid;
    grid-template-columns:repeat(8,1fr);
    border:2px solid white;
}

.cell{
    width:42px;
    height:42px;
    background:green;
    border:1px solid black;
    display:flex;
    align-items:center;
    justify-content:center;
}

.black,.white{
    width:32px;
    height:32px;
    border-radius:50%;
}

.black{
    background:black;
}

.white{
    background:white;
}
</style>
</head>

<body>

<h1>オセロ</h1>

<div id="board"></div>

<script>
const board = document.getElementById("board");

let cells = [];

for(let y=0;y<8;y++){

    cells[y]=[];

    for(let x=0;x<8;x++){

        const cell=document.createElement("div");
        cell.className="cell";

        board.appendChild(cell);

        cells[y][x]=cell;
    }
}

putPiece(3,3,"white");
putPiece(4,4,"white");
putPiece(3,4,"black");
putPiece(4,3,"black");

function putPiece(x,y,color){

    const piece=document.createElement("div");

    piece.className=color;

    cells[y][x].innerHTML="";
    cells[y][x].appendChild(piece);
}
</script>

</body>
</html>
